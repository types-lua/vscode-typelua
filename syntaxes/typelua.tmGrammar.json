{
  "name": "TypeLua",
  "scopeName": "source.tlua",
  "fileTypes": [
    "tl"
  ],
  "foldingStartMarker": "(?i)^\\s*(function\\b|if\\b|for\\b|while\\b|do\\b|repeat\\b|class\\b|interface\\b|enum\\b|macro\\b|select\\b).*?$",
  "foldingStopMarker": "(?i)^\\s*(end\\b|until\\b|\\}).*?$",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#types"
    },
    {
      "include": "#table-keys"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tlua",
          "begin": "--\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.tlua"
            }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.tlua"
            }
          }
        },
        {
          "name": "comment.line.double-dash.tlua",
          "match": "--.*$",
          "captures": {
            "0": {
              "name": "comment.line.double-dash.tlua"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.long.tlua",
          "begin": "\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tlua"
            }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tlua"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.tlua",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.tlua",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tlua"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tlua"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.tlua",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.tlua",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tlua"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tlua"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.tlua",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tlua",
          "match": "(?<![\\w$.])0[xX][0-9a-fA-F_]+(\\.[0-9a-fA-F_]*)?([pP][+-]?\\d+)?(?![\\w$])"
        },
        {
          "name": "constant.numeric.decimal.tlua",
          "match": "(?<![\\w$.])(\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?|\\.\\d+([eE][+-]?\\d+)?)(?![\\w$])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.class.tlua",
          "match": "\\b(abstract\\s+)?(local\\s+)?(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.tlua"
            },
            "2": {
              "name": "keyword.control.tlua"
            },
            "3": {
              "name": "storage.type.tlua"
            },
            "4": {
              "name": "entity.name.class.tlua"
            }
          }
        },
        {
          "name": "meta.declaration.interface.tlua",
          "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.tlua"
            },
            "2": {
              "name": "entity.name.type.tlua"
            }
          }
        },
        {
          "name": "meta.declaration.enum.tlua",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.tlua"
            },
            "2": {
              "name": "entity.name.type.tlua"
            }
          }
        },
        {
          "name": "meta.declaration.type-alias.tlua",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.tlua"
            },
            "2": {
              "name": "entity.name.type.tlua"
            }
          }
        },
        {
          "name": "meta.declaration.macro.tlua",
          "match": "\\b(macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.tlua"
            },
            "2": {
              "name": "entity.name.function.macro.tlua"
            }
          }
        },
        {
          "name": "meta.declaration.function.tlua",
          "match": "\\b(local\\s+)?(function)\\s+([A-Za-z_][A-Za-z0-9_.:]*)",
          "captures": {
            "1": {
              "name": "keyword.control.tlua"
            },
            "2": {
              "name": "keyword.control.tlua"
            },
            "3": {
              "name": "entity.name.function.tlua"
            }
          }
        },
        {
          "name": "meta.declaration.method.tlua",
          "match": "\\b(constructor)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.constructor.tlua"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tlua",
          "match": "\\b(local|function|end|if|then|else|elseif|for|while|do|return|break|goto|repeat|until|in|and|or|not|declare|export|import|from|macro|defer|errdefer|async|await|spawn|select|case|default)\\b"
        },
        {
          "name": "storage.type.tlua",
          "match": "\\b(type|interface|enum|class|extends|implements|chan)\\b"
        },
        {
          "name": "storage.modifier.tlua",
          "match": "\\b(public|private|protected|static|readonly|abstract)\\b"
        },
        {
          "name": "keyword.operator.word.tlua",
          "match": "\\b(as|infer|keyof|typeof|super|is)\\b"
        },
        {
          "name": "variable.language.self.tlua",
          "match": "\\bself\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tlua",
          "match": "\\b(nil|true|false)\\b"
        },
        {
          "name": "constant.language.vararg.tlua",
          "match": "\\.\\.\\."
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tlua",
          "match": "\\b(print|require|error|assert|pcall|xpcall|tostring|tonumber|type|pairs|ipairs|select|next|setmetatable|getmetatable|rawget|rawset|rawequal|rawlen|collectgarbage|dofile|load|loadfile|coroutine|table|string|math|io|os|package)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.attribute.tlua",
          "match": "(<)(const|close)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.begin.tlua"
            },
            "2": {
              "name": "storage.modifier.attribute.tlua"
            },
            "3": {
              "name": "punctuation.definition.annotation.end.tlua"
            }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "meta.label.tlua",
          "match": "(::)([A-Za-z_][A-Za-z0-9_]*)(::)",
          "captures": {
            "1": {
              "name": "punctuation.definition.label.begin.tlua"
            },
            "2": {
              "name": "entity.name.label.tlua"
            },
            "3": {
              "name": "punctuation.definition.label.end.tlua"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.method-call.tlua",
          "match": "([:.])([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[\\(<])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.tlua"
            },
            "2": {
              "name": "entity.name.function.method.tlua"
            }
          }
        },
        {
          "name": "meta.function-call.tlua",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\(|\"|'|\\[\\[|\\[=)",
          "captures": {
            "1": {
              "name": "entity.name.function.tlua"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tlua",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "storage.type.primitive.tlua",
          "match": "\\b(any|unknown|never|void|boolean|number|integer|float|string|table|function|thread|userdata|cdata|ctype)\\b"
        }
      ]
    },
    "table-keys": {
      "patterns": [
        {
          "name": "meta.mapping.key.tlua",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?==[^=])",
          "captures": {
            "1": {
              "name": "variable.other.property.tlua"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.tlua",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.tlua",
          "match": "!=|~=|==|<=|>=|<<|>>|//|\\.\\.|[+\\-*/%^#&|~<>=]"
        },
        {
          "name": "keyword.operator.unary.tlua",
          "match": "(?<![\\w).\\]\"'\\d])(\\-|#)(?![=])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.tlua",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.brace.tlua",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "punctuation.accessor.tlua",
          "match": "\\."
        }
      ]
    }
  }
}
