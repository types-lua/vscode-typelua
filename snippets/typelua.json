{
  "Local function": {
    "prefix": [
      "lfunc",
      "local function"
    ],
    "body": [
      "local function ${1:name}(${2:args}): ${3:void}",
      "\t${0}",
      "end"
    ],
    "description": "Local function with optional return type"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "function ${1:M}.${2:name}(${3:args}): ${4:void}",
      "\t${0}",
      "end"
    ],
    "description": "Module-level function"
  },
  "Typed local": {
    "prefix": "local",
    "body": "local ${1:name}: ${2:type} = ${0:value}",
    "description": "Local variable with type annotation"
  },
  "Type alias": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = {",
      "\t${2:field}: ${3:type},",
      "}"
    ],
    "description": "Type alias for a table shape"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\t${2:field}: ${3:type},",
      "\t${4:method}(arg: ${5:type}): ${6:void},",
      "}"
    ],
    "description": "Interface declaration"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} { ${2:A} = \"${3:a}\", ${4:B} = \"${5:b}\" }"
    ],
    "description": "String enum"
  },
  "Numeric enum": {
    "prefix": "numenum",
    "body": [
      "enum ${1:Name} { ${2:A}, ${3:B} }"
    ],
    "description": "Auto-increment numeric enum"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}${2: extends ${3:Base}} {",
      "\tconstructor(${4:args}) ${5:super(${4:args}) }end,",
      "\t${6:method}(): ${7:void} ${0}end,",
      "}"
    ],
    "description": "Class with constructor"
  },
  "If nil check": {
    "prefix": "ifnil",
    "body": [
      "if ${1:x} ~= nil then",
      "\t${0}",
      "end"
    ],
    "description": "Nil-guard if statement"
  },
  "If type narrow": {
    "prefix": "iftype",
    "body": [
      "if type(${1:x}) == \"${2:string}\" then",
      "\t${0}",
      "end"
    ],
    "description": "type() narrowing if statement"
  },
  "Numeric for": {
    "prefix": "fori",
    "body": [
      "for ${1:i} = ${2:1}, ${3:n} do",
      "\t${0}",
      "end"
    ],
    "description": "Numeric for loop"
  },
  "Generic for": {
    "prefix": "forin",
    "body": [
      "for ${1:k}, ${2:v} in ${3:pairs}(${4:t}) do",
      "\t${0}",
      "end"
    ],
    "description": "Generic for loop"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:cond} do",
      "\t${0}",
      "end"
    ],
    "description": "While loop"
  },
  "Macro expression": {
    "prefix": "macro",
    "body": "macro ${1:name}(${2:x}) = (${2:x}) ${3:+} (${0})",
    "description": "Expression macro"
  },
  "Macro statement": {
    "prefix": "smacro",
    "body": [
      "macro ${1:name}(${2:cond}, ${3:body}) do",
      "\tif not (${2:cond}) then",
      "\t\t${3:body}",
      "\tend",
      "end"
    ],
    "description": "Statement macro"
  },
  "Import module": {
    "prefix": "import",
    "body": "import ${1:M}: ${2:Api} from \"${3:module.path}\"",
    "description": "Typed module import"
  },
  "Defer": {
    "prefix": "defer",
    "body": "defer ${1:cleanup()}",
    "description": "Deferred cleanup call"
  },
  "Print": {
    "prefix": "print",
    "body": "print(${0})",
    "description": "Print to stdout"
  },
  "Test case": {
    "prefix": "test",
    "body": [
      "import T from \"tlua_test\"",
      "",
      "return {",
      "\t[\"${1:case name}\"] = function(): void",
      "\t\t${0:T.eq(actual, expected)}",
      "\tend,",
      "}"
    ],
    "description": "TypeLua test file using the built-in tlua_test assertions"
  },
  "Relative import": {
    "prefix": "importrel",
    "body": "import ${1:Name} from \"./${2:module}\"",
    "description": "Package-local (relative) import"
  },
  "Async function": {
    "prefix": [
      "async",
      "afunc"
    ],
    "body": [
      "async function ${1:name}(): ${2:void}",
      "\t${0}",
      "end"
    ],
    "description": "Async function (await/spawn scheduling)"
  },
  "Spawn task": {
    "prefix": "spawn",
    "body": "spawn ${1:worker}()",
    "description": "Spawn a cooperative task"
  },
  "Defer cleanup": {
    "prefix": "defer",
    "body": "defer ${1:cleanup}()",
    "description": "Run a call at function exit (LIFO)"
  },
  "Macro": {
    "prefix": "macro",
    "body": [
      "macro ${1:name}(${2:arg}) = (${3:arg})"
    ],
    "description": "Hygienic expression macro"
  },
  "Select block": {
    "prefix": "select",
    "body": [
      "select {",
      "\tcase local ${1:v} = ${2:ch}:recv() then",
      "\t\t${3:print(v)}",
      "\tdefault then",
      "\t\t${0}",
      "}"
    ],
    "description": "Channel select with default"
  }
}
